# 変数名だけを置く。秘密鍵・トークンの値はここに書かない（.env はコミットしない）

# ===== ゲートウェイ（npm run gateway）=====
PORT=
# 買い手から見たゲートウェイの公開 URL（402 の resource.url に入る）
PUBLIC_BASE_URL=
# 受け付けるチェーン（カンマ区切り）。既定 eip155:137,eip155:43114（Polygon・Avalanche）。Kaia（eip155:8217）は指定したときだけ
# Polygon は CDP、Avalanche（と Kaia）は CDP が未対応なのでゲートウェイ内の自前 facilitator（relayer がガスを払う）
ENABLED_NETWORKS=
# 旧設定（1 チェーンだけのとき）。ENABLED_NETWORKS があればそちらを使う
JPYC_NETWORK=

# CDP facilitator（Polygon 用）
FACILITATOR_URL=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# RPC。チェーンごとに RPC_URL_<POLYGON|AVALANCHE|KAIA|ETHEREUM|AMOY>、無ければ公開 RPC
POLYGON_RPC_URL=
RPC_URL_POLYGON=
RPC_URL_AVALANCHE=
RPC_URL_KAIA=
# 自前 facilitator の relayer（チェーンごとに別の鍵。payTo・上流購入用・買い手の鍵とは別）
RELAYER_PRIVATE_KEY_AVALANCHE=
RELAYER_PRIVATE_KEY_KAIA=
# 自前 facilitator が受け付ける 1 件の上限（JPYC）
RELAYER_MAX_JPYC=
# true で起動時の /supported 確認を警告だけにする（開発用。本番では設定しない）
SKIP_FACILITATOR_CHECK=
# 受取アドレス（x402 Inc. 管理）。秘密鍵はどこにも置かない（PAYTO_PRIVATE_KEY があると起動しない）
JPYC_PAY_TO=
PRICE_SERIES_JPYC=
PRICE_MOVERS_JPYC=
PRICE_OSD_JPYC=
# x402scan の openapi に載せる参考の USD 換算（請求は JPYC）。既定 0.0066
JPYC_USD_RATE=

UPSTREAM_JIN_BASE_URL=
UPSTREAM_OSD_BASE_URL=
# 上流購入用（Solana、base58 64 バイト）。poc-card-credits の GATEWAY_WALLET_SECRET とは別の鍵（npm run wallet:new -- --solana）
UPSTREAM_SOLANA_PRIVATE_KEY=
# 上流への 1 日（JST）の支払い上限（USD）。超えると 503。既定 2
UPSTREAM_DAILY_CAP_USD=

# nonce・支払者のブロック・上流の日次支出を関数間で共有する場所。blob（既定・本番）| memory（開発のみ。Vercel では起動しない）
STATE_STORE=

# ===== 決済ログ =====
# blob（既定・本番）: Vercel Blob の log/YYYY-MM-DD.jsonl（JST）。poc-card-credits と同じ出力先
# file: ローカルの $LOG_DIR/YYYY-MM-DD.jsonl。NODE_ENV=development のときだけ有効
LOG_SINK=
NODE_ENV=
BLOB_READ_WRITE_TOKEN=
LOG_DIR=

# ===== 買い手スクリプト（npm run buyer）。BUYER_PRIVATE_KEY はゲートウェイの環境には置かない（置くと起動しない）=====
BUYER_PRIVATE_KEY=
GATEWAY_URL=
BUYER_DAILY_CAP_JPYC=
# 既定 /jin/series,/jin/movers
BUYER_PATHS=
# 既定 true（同じ JST 日に購入済みのパスは買わない）
BUYER_ONCE_PER_DAY=
# 任意：402 の payTo がこれと違えば署名しない
BUYER_EXPECTED_PAY_TO=
BUYER_LOG_DIR=
# 任意：ゲートウェイが返す X-PAYMENT-LOG（決済ログの 1 行）をこのディレクトリに日付ごとに書く（Actions 用）
GATEWAY_LOG_DIR=

# ===== B：自前ホストの facilitator（npm run facilitator:serve、CDP が通らないときの予備）=====
# 役割ごとにファイルを分けて DOTENV_CONFIG_PATH=.env.facilitator で起動する（ゲートウェイ・買い手の鍵と同居させない）
RELAYER_PRIVATE_KEY=
# ゲートウェイの FACILITATOR_AUTH_TOKEN と同じ値（32 文字以上）
FACILITATOR_AUTH_TOKEN=
FACILITATOR_ALLOWED_PAY_TO=
FACILITATOR_MAX_JPYC=
FACILITATOR_PORT=
